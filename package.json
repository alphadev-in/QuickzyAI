{
  "name": "quickzy-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "Quickzy - Same-day London Delivery Platform",
  "workspaces": [
    "web",
    "functions"
  ],
  "scripts": {
    "build": "npm run build --workspace=web && mkdir -p .next/standalone/.next && cp -r web/.next/standalone/web/.next/* .next/standalone/.next/ 2>/dev/null || true",
    "start": "npm run start --workspace=web",
    "dev": "npm run dev --workspace=web"
  },
  "dependencies": {
    "next": "16.4.2",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  }
}
