rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isAuthenticated() && (request.auth.uid == userId || request.auth.token.email == userId);
    }
    
    function isAdmin() {
      return isAuthenticated() && request.auth.token.email == 'prajapatikaranc@gmail.com';
    }

    // Users Collection
    match /users/{userId} {
      allow read: if isAuthenticated() && (isOwner(userId) || isAdmin());
      allow write: if isAuthenticated() && (isOwner(userId) || isAdmin());
    }

    // Addresses Collection
    match /addresses/{addressId} {
      allow read: if isAuthenticated() && (request.auth.token.email == resource.data.userId || request.auth.uid == resource.data.userId || isAdmin());
      allow create: if isAuthenticated() && (request.auth.token.email == request.resource.data.userId || request.auth.uid == request.resource.data.userId || isAdmin());
      allow update, delete: if isAuthenticated() && (request.auth.token.email == resource.data.userId || request.auth.uid == resource.data.userId || isAdmin());
    }

    // System Settings (Pricing metrics config)
    match /system_settings/{settingId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Drivers collection
    match /drivers/{driverId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated() && (request.auth.uid == driverId || isAdmin());
    }

    // Orders Collection
    match /orders/{orderId} {
      // resource.data.get(key, default) means a missing field (e.g. no driver yet) cannot make the
      // whole query fail. Admin is checked first.
      allow read: if isAuthenticated() && (
        isAdmin() ||
        request.auth.token.email == resource.data.get('userEmail', '') ||
        request.auth.token.email == resource.data.get('userId', '') ||
        request.auth.uid == resource.data.get('userId', '') ||
        request.auth.token.email == resource.data.get('assignedDriverEmail', '') ||
        request.auth.uid == resource.data.get('assignedDriverId', '')
      );
      // Authenticated users can create orders
      allow create: if isAuthenticated();
      // Only admin, owner, or assigned driver can update order status
      allow update: if isAuthenticated() && (
        isAdmin() ||
        request.auth.token.email == resource.data.get('userId', '') ||
        request.auth.token.email == resource.data.get('assignedDriverEmail', '') ||
        request.auth.uid == resource.data.get('assignedDriverId', '')
      );
      allow delete: if isAdmin();
    }

    // Customer module: each user manages only their own customers
    match /customers/{customerId} {
      allow read: if isAuthenticated() && (request.auth.token.email == resource.data.ownerEmail || isAdmin());
      allow create, update: if isAuthenticated() && (request.auth.token.email == request.resource.data.ownerEmail || isAdmin());
      allow delete: if isAuthenticated() && (request.auth.token.email == resource.data.ownerEmail || isAdmin());
    }

    // Prepaid credit balance (keyed by customer email, lowercase)
    // TODO before production: move balance writes to a server-side Stripe webhook (Admin SDK).
    // Until then the browser writes the balance after a verified Stripe payment, so customers can
    // only write their own balance document.
    match /customer_credit/{email} {
      allow read: if isAuthenticated() && (request.auth.token.email.lower() == email || isAdmin());
      allow create, update: if isAuthenticated() && (request.auth.token.email.lower() == email || isAdmin());
    }

    // Credit audit trail. Ledger ids for top-ups are the Stripe PaymentIntent id, so a retried
    // top-up can check whether it was already credited. resource == null covers that check.
    match /credit_ledger/{entryId} {
      allow read: if isAuthenticated() && (
        resource == null ||
        request.auth.token.email.lower() == resource.data.ownerEmail ||
        isAdmin()
      );
      allow create: if isAuthenticated() && (
        request.auth.token.email.lower() == request.resource.data.ownerEmail || isAdmin()
      );
    }

    // In-app notifications. Admin creates them on driver assignment; the recipient reads them
    // and can only mark them read.
    match /notifications/{notificationId} {
      allow read: if isAuthenticated() && (
        resource == null ||
        request.auth.token.email.lower() == resource.data.recipientEmail ||
        isAdmin()
      );
      allow create: if isAdmin();
      allow update: if isAuthenticated()
        && request.auth.token.email.lower() == resource.data.recipientEmail
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']);
      allow delete: if isAuthenticated() && request.auth.token.email.lower() == resource.data.recipientEmail;
    }

    // Help chat: one thread per user (keyed by lowercase email). Admin can reply and resolve.
    match /support_threads/{email} {
      allow read: if isAuthenticated() && (request.auth.token.email.lower() == email || isAdmin());
      allow create, update: if isAuthenticated() && (request.auth.token.email.lower() == email || isAdmin());
      match /messages/{messageId} {
        allow read: if isAuthenticated() && (request.auth.token.email.lower() == email || isAdmin());
        allow create: if isAuthenticated() && (
          (request.auth.token.email.lower() == email && request.resource.data.from == 'customer') ||
          (isAdmin() && request.resource.data.from == 'admin')
        );
      }
    }

    // Bulk Imports Collection
    match /bulk_imports/{importId} {
      allow read: if isAuthenticated() && (request.auth.token.email == resource.data.clientId || isAdmin());
      allow create: if isAuthenticated();
      allow update, delete: if isAdmin();
    }
  }
}
